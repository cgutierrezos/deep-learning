    "chat.tools.terminal.autoApprove": {
        "/^cd /workspaces/practica/src/entrega1 && python3 << 'PYEOF'\nimport json\nfrom pathlib import Path\n\nnb_path = Path\\('taller_heloc_modelado\\.ipynb'\\)\nnb = json\\.loads\\(nb_path\\.read_text\\(\\)\\)\n\ncells = nb\\['cells'\\]\nby_id = \\{c\\.get\\('id'\\): c for c in cells\\}\n\ndef set_src\\(cell_id, text\\):\n    if cell_id not in by_id:\n        raise KeyError\\(f'Cell id not found: \\{cell_id\\}'\\)\n    lines = text\\.split\\('\\\\n'\\)\n    by_id\\[cell_id\\]\\['source'\\] = lines\n\ndef replace_in_cell\\(cell_id, old, new\\):\n    c = by_id\\[cell_id\\]\n    s = '\\\\n'\\.join\\(c\\['source'\\]\\)\n    if old in s:\n        s = s\\.replace\\(old, new\\)\n        c\\['source'\\] = s\\.split\\('\\\\n'\\)\n\n# -----------------------------\n# Paso C\n# -----------------------------\nset_src\\('#VSC-c4ed7806', \"\"\"---\n### Paso C — Imputar \\(rellenar\\) los datos faltantes que quedan\n\nLos algoritmos de Machine Learning no aceptan celdas vacías\\. Una vez decidimos que ciertas columnas sí vale la pena conservar \\(porque no superan el umbral del 20%\\), necesitamos rellenar esos huecos\\.\n\nEn este punto ya tenemos la clasificación de variables numéricas:\n- `continuous_cols`: variables continuas\n- `discrete_cols`: variables discretas\n\nPor eso la imputación se hace de forma diferenciada\\.\n\n\\| Tipo de variable \\| Estrategia de imputación \\| Razón \\|\n\\|---\\|---\\|---\\|\n\\| Continuas \\| Mediana \\| Es robusta a outliers y sesgo \\|\n\\| Discretas \\| Moda \\(`most_frequent`\\) \\| Mantiene valores válidos del dominio discreto \\|\n\n> Ejemplo: si una variable discreta solo tiene valores `\\{0,1,2,3\\}`, imputar con mediana puede producir 1\\.5, que no existe en esa variable\\. Con moda eso no pasa\\.\"\"\"\\)\n\nset_src\\('#VSC-8c998992', \"\"\"#### Paso C\\.1 — Crear imputadores por tipo de variable\n\nCreamos un imputador para continuas y otro para discretas\\. Aún no modificamos datos\\.\"\"\"\\)\n\nset_src\\('#VSC-126570b3', \"\"\"# Imputador para variables continuas \\(mediana\\)\nimputer_continuous = SimpleImputer\\(strategy='median'\\)\n\n# Imputador para variables discretas \\(moda\\)\nimputer_discrete = SimpleImputer\\(strategy='most_frequent'\\)\n\nprint\\('Imputadores configurados:'\\)\nprint\\(f'  - Continuas: \\{len\\(continuous_cols\\)\\} columnas -> median'\\)\nprint\\(f'  - Discretas: \\{len\\(discrete_cols\\)\\} columnas -> most_frequent'\\)\"\"\"\\)\n\nset_src\\('#VSC-e352cdd8', \"\"\"#### Paso C\\.2 — Preparar copia y aplicar imputación diferenciada\n\nEn esta etapa aplicamos cada imputador a su grupo correspondiente:\n- continuas con mediana\n- discretas con moda\"\"\"\\)\n\nset_src\\('#VSC-ec498c5f', \"\"\"#### Paso C\\.2\\.b — Ejecutar la imputación por tipo\n\nAplicamos los dos imputadores sobre `X_imputed` y verificamos nulos restantes\\.\"\"\"\\)\n\nset_src\\('#VSC-390b28c4', \"\"\"# Ejecutar imputación diferenciada\nX_imputed = X\\.copy\\(\\)\n\nif len\\(continuous_cols\\) > 0:\n    X_imputed\\[continuous_cols\\] = imputer_continuous\\.fit_transform\\(X_imputed\\[continuous_cols\\]\\)\n\nif len\\(discrete_cols\\) > 0:\n    X_imputed\\[discrete_cols\\] = imputer_discrete\\.fit_transform\\(X_imputed\\[discrete_cols\\]\\)\n\nprint\\('Imputación ejecutada por tipo de variable\\.'\\)\nprint\\(f'Nulos en continuas: \\{int\\(X_imputed\\[continuous_cols\\]\\.isna\\(\\)\\.sum\\(\\)\\.sum\\(\\)\\) if len\\(continuous_cols\\) > 0 else 0\\}'\\)\nprint\\(f'Nulos en discretas: \\{int\\(X_imputed\\[discrete_cols\\]\\.isna\\(\\)\\.sum\\(\\)\\.sum\\(\\)\\) if len\\(discrete_cols\\) > 0 else 0\\}'\\)\nprint\\('Nulos totales después de imputar:', int\\(X_imputed\\[num_cols\\]\\.isna\\(\\)\\.sum\\(\\)\\.sum\\(\\)\\)\\)\"\"\"\\)\n\n# -----------------------------\n# Paso D \\(outliers\\): solo continuas\n# -----------------------------\nreplace_in_cell\\('#VSC-cbcb5c2e', '### Paso D — Detectar y tratar los valores extremos \\(\\*outliers\\*\\)', '### Paso D — Detectar y tratar outliers en variables continuas'\\)\nreplace_in_cell\\('#VSC-cbcb5c2e', '### Paso D — Detectar y tratar outliers en variables continuas\\\\n\\\\nUn \\*\\*valor extremo\\*\\* \\(\\*outlier\\*\\) es una observación que se aleja mucho del resto\\. Por ejemplo, si la mayoría de clientes tiene 5 deudas pero uno tiene 200, ese es un outlier\\.',\n                '### Paso D — Detectar y tratar outliers en variables continuas\\\\n\\\\nEn este paso aplicamos capping solo sobre `continuous_cols`\\.\\\\n\\\\nUn \\*\\*valor extremo\\*\\* \\(\\*outlier\\*\\) es una observación que se aleja mucho del resto\\. Por ejemplo, si la mayoría de clientes tiene 5 deudas pero uno tiene 200, ese es un outlier\\.'\\)\n\nset_src\\('#VSC-41060fc3', \"\"\"IQR_MULTIPLIER = 1\\.5  # Límite = Q1 ± IQR_MULTIPLIER × IQR\n\n# Calcular límites IQR solo para variables continuas\nq1 = X_imputed\\[continuous_cols\\]\\.quantile\\(0\\.25\\)\nq3 = X_imputed\\[continuous_cols\\]\\.quantile\\(0\\.75\\)\niqr = q3 - q1\n\nlower = q1 - IQR_MULTIPLIER \\* iqr\nupper = q3 \\+ IQR_MULTIPLIER \\* iqr\n\nprint\\(f'Límites IQR calculados para \\{len\\(continuous_cols\\)\\} variables continuas \\(multiplicador = \\{IQR_MULTIPLIER\\}\\)\\.'\\)\nprint\\('lower:\\\\n', lower\\.head\\(\\)\\)\nprint\\('upper:\\\\n', upper\\.head\\(\\)\\)\"\"\"\\)\n\nset_src\\('#VSC-4d9f16c7', \"\"\"# Contar outliers antes del capping \\(solo continuas\\)\noutlier_counts_before = \\(\\(X_imputed\\[continuous_cols\\] < lower\\) \\| \\(X_imputed\\[continuous_cols\\] > upper\\)\\)\\.sum\\(\\)\\.sort_values\\(ascending=False\\)\n\nprint\\('Top 10 variables continuas con más outliers \\(antes de capping\\):'\\)\nprint\\(outlier_counts_before\\.head\\(10\\)\\)\"\"\"\\)\n\nset_src\\('#VSC-4d7991a6', \"\"\"# Aplicar capping solo a variables continuas\nX_capped = X_imputed\\.copy\\(\\)\nX_capped\\[continuous_cols\\] = X_capped\\[continuous_cols\\]\\.clip\\(lower=lower, upper=upper, axis=1\\)\n\nprint\\('Capping aplicado correctamente sobre variables continuas\\.'\\)\nprint\\(f'Dimensión de X_capped: \\{X_capped\\.shape\\}'\\)\"\"\"\\)\n\nset_src\\('#VSC-fefbe29a', \"\"\"# Contar outliers después del capping \\(solo continuas\\)\noutlier_counts_after = \\(\\(X_capped\\[continuous_cols\\] < lower\\) \\| \\(X_capped\\[continuous_cols\\] > upper\\)\\)\\.sum\\(\\)\\.sort_values\\(ascending=False\\)\n\nprint\\('Outliers restantes en variables continuas \\(debe ser 0\\):'\\)\nprint\\(outlier_counts_after\\.head\\(10\\)\\)\"\"\"\\)\n\n# -----------------------------\n# Paso E: NO recalcular clasificación\n# -----------------------------\nset_src\\('#VSC-f650e740', \"\"\"#### Reutilizar la clasificación discreta/continua ya calculada\n\nEn el Paso C ya clasificamos las variables en `discrete_cols` y `continuous_cols`\\.\n\nAquí no recalculamos esa clasificación: solo la mostramos como recordatorio y reutilizamos esos mismos grupos para decidir dónde aplicar `log1p`\\.\"\"\"\\)\n\nset_src\\('#VSC-412115bb', \"\"\"# Reutilizar la clasificación del Paso C \\(sin recalcular\\)\nprint\\(f'Variables discretas detectadas en Paso C: \\{len\\(discrete_cols\\)\\}'\\)\nprint\\(f'Variables continuas detectadas en Paso C: \\{len\\(continuous_cols\\)\\}'\\)\n\n# Tabla de referencia \\(ya calculada en Paso C\\)\nvar_type_df = pd\\.DataFrame\\(\\{\n    'tipo_detectado': \\['discreta' if c in discrete_cols else 'continua' for c in num_cols\\]\n\\}, index=num_cols\\)\n\nprint\\('\\\\nEjemplo de clasificación reutilizada:'\\)\nprint\\(var_type_df\\.head\\(12\\)\\)\"\"\"\\)\n\n# -----------------------------\n# Sección de guardado/uso del pipeline\n# -----------------------------\nset_src\\('#VSC-b6d796cc', \"\"\"import joblib\n\n# Crear diccionario con todo el pipeline\npreprocessing_pipeline = \\{\n    # Transformadores entrenados\n    'imputer_continuous': imputer_continuous,\n    'imputer_discrete': imputer_discrete,\n    'scaler': scaler,\n    'pca': pca,\n    'pca_full': pca_full,  # PCA con todos los componentes \\(para análisis futuros\\)\n\n    # Configuración de variables\n    'num_cols': num_cols,\n    'log_cols': log_cols,\n    'discrete_cols': discrete_cols,\n    'continuous_cols': continuous_cols,\n\n    # Límites IQR para capping \\(solo en continuas\\)\n    'lower_iqr': lower,\n    'upper_iqr': upper,\n\n    # Umbrales utilizados\n    'missing_threshold': MISSING_THRESHOLD,\n    'iqr_multiplier': IQR_MULTIPLIER,\n    'skew_threshold': SKEW_THRESHOLD,\n    'pca_variance_threshold': PCA_VARIANCE_THRESHOLD,\n    'discrete_unique_threshold': DISCRETE_UNIQUE_THRESHOLD,\n    'discrete_ratio_threshold': DISCRETE_RATIO_THRESHOLD,\n\n    # Información del PCA\n    'n_components_selected': n_components_95,\n    'pca_variance_explained': pca\\.explained_variance_ratio_,\n    'pca_variance_cumulative': np\\.cumsum\\(pca\\.explained_variance_ratio_\\),\n    'pca_component_names': pc_names,\n\\}\n\n# Guardar el pipeline\njoblib\\.dump\\(preprocessing_pipeline, 'preprocessing_pipeline\\.joblib'\\)\nprint\\('✅ Pipeline guardado: preprocessing_pipeline\\.joblib'\\)\nprint\\(f'\\\\nContenido del pipeline:'\\)\nfor key in preprocessing_pipeline\\.keys\\(\\):\n    value = preprocessing_pipeline\\[key\\]\n    if isinstance\\(value, \\(int, float, str\\)\\):\n        print\\(f'  - \\{key\\}: \\{value\\}'\\)\n    elif isinstance\\(value, \\(list, np\\.ndarray\\)\\):\n        try:\n            print\\(f'  - \\{key\\}: lista/array con \\{len\\(value\\)\\} elementos'\\)\n        except:\n            print\\(f'  - \\{key\\}: objeto con len\\(\\) indefinido'\\)\n    else:\n        print\\(f'  - \\{key\\}: \\{type\\(value\\)\\.__name__\\} \\(objeto entrenado\\)'\\)\"\"\"\\)\n\n# Update major markdown/tutorial references with in-cell replacements\nfor cid in \\['#VSC-838c3de0', '#VSC-d76ea47c', '#VSC-c02ae5b8', '#VSC-3d8917b2', '#VSC-c17c6349'\\]:\n    s = '\\\\n'\\.join\\(by_id\\[cid\\]\\['source'\\]\\)\n    s = s\\.replace\\(\"- `imputer`: SimpleImputer entrenado \\(medianas\\)\",\n                  \"- `imputer_continuous`: SimpleImputer entrenado \\(mediana para continuas\\)\\\\n- `imputer_discrete`: SimpleImputer entrenado \\(moda para discretas\\)\"\\)\n    s = s\\.replace\\(\"'imputer': imputer,\", \"'imputer_continuous': imputer_continuous,\\\\n    'imputer_discrete': imputer_discrete,\"\\)\n    s = s\\.replace\\(\"'imputation_strategy': IMPUTATION_STRATEGY,\\\\n\", \"\"\\)\n    s = s\\.replace\\(\"imputer = pipeline\\['imputer'\\]\", \"imputer_continuous = pipeline\\['imputer_continuous'\\]\\\\nimputer_discrete = pipeline\\['imputer_discrete'\\]\"\\)\n    s = s\\.replace\\(\"X_new\\[num_cols\\] = imputer\\.transform\\(X_new\\[num_cols\\]\\)\",\n                  \"X_new\\[continuous_cols\\] = imputer_continuous\\.transform\\(X_new\\[continuous_cols\\]\\)\\\\nX_new\\[discrete_cols\\] = imputer_discrete\\.transform\\(X_new\\[discrete_cols\\]\\)\"\\)\n    s = s\\.replace\\(\"X_nuevo\\[num_cols\\] = imputer\\.transform\\(X_nuevo\\[num_cols\\]\\)\",\n                  \"X_nuevo\\[continuous_cols\\] = imputer_continuous\\.transform\\(X_nuevo\\[continuous_cols\\]\\)\\\\nX_nuevo\\[discrete_cols\\] = imputer_discrete\\.transform\\(X_nuevo\\[discrete_cols\\]\\)\"\\)\n    s = s\\.replace\\(\"\\| \\*\\*imputer\\*\\* \\| La mediana de cada columna numérica \\| Para rellenar valores faltantes en exactamente el mismo orden \\|\",\n                  \"\\| \\*\\*imputer_continuous\\*\\* \\| Mediana de variables continuas \\| Para imputar faltantes continuos \\|\\\\n\\| \\*\\*imputer_discrete\\*\\* \\| Moda de variables discretas \\| Para imputar faltantes discretos \\|\"\\)\n    s = s\\.replace\\(\"X_test_imputed = imputer\\.fit_transform\\(X_test\\[num_cols\\]\\)  # ¡MALO!\",\n                  \"X_test\\[continuous_cols\\] = imputer_continuous\\.fit_transform\\(X_test\\[continuous_cols\\]\\)  # ¡MALO!\"\\)\n    s = s\\.replace\\(\"X_test_imputed = imputer\\.transform\\(X_test\\[num_cols\\]\\)  # Solo \\.transform\\(\\)\",\n                  \"X_test\\[continuous_cols\\] = imputer_continuous\\.transform\\(X_test\\[continuous_cols\\]\\)\\\\nX_test\\[discrete_cols\\] = imputer_discrete\\.transform\\(X_test\\[discrete_cols\\]\\)  # Solo \\.transform\\(\\)\"\\)\n    by_id\\[cid\\]\\['source'\\] = s\\.split\\('\\\\n'\\)\n\n# Explicitly fix summary code cell\nset_src\\('#VSC-b55090db', \"\"\"# Crear resumen completo del pipeline\nprint\\(\"=\" \\* 80\\)\nprint\\(\"RESUMEN FINAL DEL PIPELINE DE PREPROCESAMIENTO\"\\)\nprint\\(\"=\" \\* 80\\)\n\nprint\\(\"\\\\n📊 ESTADÍSTICAS DEL DATASET:\"\\)\nprint\\(f\"  Filas iniciales: \\{len\\(df\\)\\} observaciones\"\\)\nprint\\(f\"  Filas finales: \\{len\\(final_df\\)\\} observaciones\"\\)\nprint\\(f\"  Filas eliminadas: \\{len\\(df\\) - len\\(final_df\\)\\} \\(\\{\\(len\\(df\\)-len\\(final_df\\)\\)/len\\(df\\)\\*100:\\.1f\\}%\\)\"\\)\nprint\\(f\"\\\\n  Variables iniciales: \\{len\\(df\\.columns\\)-1\\} predictoras \\+ 1 objetivo\"\\)\nprint\\(f\"  Variables después de limpieza: \\{X\\.shape\\[1\\]\\} predictoras\"\\)\nprint\\(f\"  Variables después de PCA: \\{X_pca_df\\.shape\\[1\\]\\} componentes\"\\)\nprint\\(f\"  Reducción de variables: \\{X\\.shape\\[1\\]\\} → \\{X_pca_df\\.shape\\[1\\]\\} \\(\\{\\(1-X_pca_df\\.shape\\[1\\]/X\\.shape\\[1\\]\\)\\*100:\\.1f\\}% menos\\)\"\\)\n\nprint\\(\"\\\\n🔧 TRANSFORMACIONES APLICADAS:\"\\)\nprint\\(f\"  1\\. Imputación diferenciada: mediana \\(continuas\\) \\+ moda \\(discretas\\) \\(rellenó \\{X\\.isna\\(\\)\\.sum\\(\\)\\.sum\\(\\)\\} celdas\\)\"\\)\nprint\\(f\"  2\\. Outlier Capping: IQR × \\{IQR_MULTIPLIER\\} \\(solo continuas, recortó \\{\\(outlier_counts_before > 0\\)\\.sum\\(\\)\\} variables\\)\"\\)\nprint\\(f\"  3\\. Log1p: \\{len\\(log_cols\\)\\} variables continuas sesgadas\"\\)\nprint\\(f\"  4\\. Estandarización: StandardScaler \\(media=0, std=1\\)\"\\)\nprint\\(f\"  5\\. Dimensionalidad: PCA con \\{n_components_95\\} componentes \\(\\{PCA_VARIANCE_THRESHOLD\\*100:\\.0f\\}% varianza\\)\"\\)\n\nprint\\(\"\\\\n📋 VARIABLES POR TIPO:\"\\)\nprint\\(f\"  Numéricas totales: \\{len\\(num_cols\\)\\}\"\\)\nprint\\(f\"    - Continuas: \\{len\\(continuous_cols\\)\\}\"\\)\nprint\\(f\"    - Discretas: \\{len\\(discrete_cols\\)\\}\"\\)\nprint\\(f\"  Variables transformadas con log1p: \\{len\\(log_cols\\)\\}\"\\)\n\nprint\\(\"\\\\n💾 ARCHIVOS GENERADOS:\"\\)\nprint\\(f\"  ✅ preprocessing_pipeline\\.joblib \\(tamaño: \\{\\(joblib\\.dump\\(preprocessing_pipeline, '_temp\\.joblib'\\), __import__\\('os'\\)\\.path\\.getsize\\('_temp\\.joblib'\\) // 1024\\)\\[1\\]\\} KB\\)\"\\)\nprint\\(f\"  ✅ heloc_pca_preprocesado\\.csv \\(tamaño: \\{\\(final_df\\.to_csv\\('_temp\\.csv', index=False\\), __import__\\('os'\\)\\.path\\.getsize\\('_temp\\.csv'\\) // 1024\\)\\[1\\]\\} KB\\)\"\\)\n\n# Limpiar archivos temporales\nimport os\nos\\.remove\\('_temp\\.joblib'\\)\nos\\.remove\\('_temp\\.csv'\\)\n\nprint\\(\"\\\\n📈 VARIANZA EXPLICADA POR PCA:\"\\)\nprint\\(f\"  Primeros 3 componentes:\"\\)\nfor i in range\\(min\\(3, len\\(pca\\.explained_variance_ratio_\\)\\)\\):\n    cum_var = np\\.sum\\(pca\\.explained_variance_ratio_\\[:i\\+1\\]\\)\n    print\\(f\"    PC\\{i\\+1\\}: \\{pca\\.explained_variance_ratio_\\[i\\]\\*100:5\\.1f\\}% \\(acumulado: \\{cum_var\\*100:5\\.1f\\}%\\)\"\\)\n\nprint\\(\"\\\\n🎯 PASOS PARA REUTILIZAR EN PRODUCCIÓN:\"\\)\nprint\\(\"\"\"\n  1\\. Carga el pipeline: pipeline = joblib\\.load\\('preprocessing_pipeline\\.joblib'\\)\n  2\\. Extrae cada transformer: imputer_continuous, imputer_discrete, scaler, pca, etc\\.\n  3\\. Aplica en orden: Imputar -> Capping -> Log -> Escalar -> PCA\n  4\\. Usa el resultado con tu modelo entrenado\n\n  ⚠️ IMPORTANTE: Usa \\.transform\\(\\), NUNCA \\.fit_transform\\(\\) en datos nuevos\n                 \\(porque la estadística ya está entrenada en los datos antiguos\\)\n\"\"\"\\)\n\nprint\\(\"=\" \\* 80\\)\nprint\\(\"✅ PREPROCESAMIENTO COMPLETADO Y GUARDADO\"\\)\nprint\\(\"=\" \\* 80\\)\"\"\"\\)\n\nset_src\\('#VSC-0eeee61b', \"\"\"# ▶▶ Verificar que el pipeline está completo y correctamente guardado\n\nprint\\(\"\\\\n🔍 VERIFICACIÓN DEL PIPELINE GUARDADO:\\\\n\"\\)\n\nrequired_keys = \\[\n    'imputer_continuous', 'imputer_discrete', 'scaler', 'pca', 'pca_full',\n    'num_cols', 'log_cols', 'discrete_cols', 'continuous_cols',\n    'lower_iqr', 'upper_iqr',\n    'missing_threshold', 'iqr_multiplier',\n    'skew_threshold', 'pca_variance_threshold', 'discrete_unique_threshold',\n    'discrete_ratio_threshold',\n    'n_components_selected', 'pca_variance_explained', 'pca_variance_cumulative',\n    'pca_component_names'\n\\]\n\nprint\\(f\"Claves esperadas: \\{len\\(required_keys\\)\\}\"\\)\nprint\\(f\"Claves presentes: \\{len\\(preprocessing_pipeline\\)\\}\\\\n\"\\)\n\nfor i, key in enumerate\\(required_keys, 1\\):\n    if key in preprocessing_pipeline:\n        val = preprocessing_pipeline\\[key\\]\n        if isinstance\\(val, \\(list, tuple\\)\\):\n            status = f\"✅ \\(lista con \\{len\\(val\\)\\} elementos\\)\"\n        elif isinstance\\(val, np\\.ndarray\\):\n            status = f\"✅ \\(array con shape \\{val\\.shape\\}\\)\"\n        elif isinstance\\(val, pd\\.Series\\):\n            status = f\"✅ \\(Series con \\{len\\(val\\)\\} índices\\)\"\n        elif isinstance\\(val, \\(int, float\\)\\):\n            status = f\"✅ \\(valor: \\{val\\}\\)\"\n        elif isinstance\\(val, str\\):\n            status = f\"✅ \\(texto: '\\{val\\}'\\)\"\n        else:\n            status = f\"✅ \\(\\{type\\(val\\)\\.__name__\\}\\)\"\n        print\\(f\"  \\{i:2d\\}\\. \\{key:30s\\} \\{status\\}\"\\)\n    else:\n        print\\(f\"  \\{i:2d\\}\\. \\{key:30s\\} ❌ FALTA\"\\)\n\nprint\\(\"\\\\n✅ RESUMEN FINAL:\"\\)\nprint\\(f\"  Pipeline completamente guardado: \\{'preprocessing_pipeline\\.joblib'\\}\"\\)\nprint\\(f\"  Dataset procesado guardado: \\{'heloc_pca_preprocesado\\.csv'\\}\"\\)\nprint\\(f\"\\\\n  Para usar en el futuro:\"\\)\nprint\\(f\"    1\\. pipeline = joblib\\.load\\('preprocessing_pipeline\\.joblib'\\)\"\\)\nprint\\(f\"    2\\. Extrae: imputer_continuous, imputer_discrete, scaler, pca, etc\\.\"\\)\nprint\\(f\"    3\\. Aplica sobre nuevos datos en el mismo orden\"\\)\nprint\\(f\"\\\\n  ⚠️  RECUERDA: En nuevos datos usa \\.transform\\(\\) NUNCA \\.fit_transform\\(\\)\"\\)\"\"\"\\)\n\nnb_path\\.write_text\\(json\\.dumps\\(nb, indent=1, ensure_ascii=False\\)\\)\nprint\\('Notebook updated successfully'\\)\nPYEOF$/": {
